{
  "name": "invoice-builder",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "description": "Web-based invoice and office expense system for multiple companies: GST invoices, expenses, reimbursements, RBAC and PDF export, backed by PostgreSQL.",
  "author": "piratuks",
  "keywords": [
    "invoice",
    "quotation",
    "quote",
    "billing",
    "gst",
    "expenses",
    "reimbursements",
    "pdf-export",
    "pdf-generation",
    "business-management",
    "finance",
    "accounting",
    "postgresql",
    "web-app",
    "invoice-builder",
    "quotation-builder",
    "billing-software",
    "business-software",
    "document-generation",
    "e-invoices",
    "peppol",
    "ubl",
    "xrechnung"
  ],
  "bugs": {
    "url": "https://github.com/piratuks/invoice-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/piratuks/invoice-builder.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm:dev:react\" \"npm:dev:webserver\"",
    "dev:react": "vite",
    "dev:webserver": "npx tsx --watch src/backend/webserver/main.ts",
    "build": "npm run build:react && npm run build:webserver",
    "build:react": "vite build",
    "build:webserver": "tsc -p tsconfig.webserver.json && node scripts/copy-webserver-assets.js",
    "migrate": "npx tsx src/backend/webserver/migrate.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.webserver.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sort:i18n": "node scripts/sort-i18n.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.7.0",
    "@react-pdf/renderer": "^4.5.1",
    "@reduxjs/toolkit": "^2.12.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "mui-color-input": "^9.0.0",
    "multer": "^2.3.0",
    "pako": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^17.0.13",
    "react-image-crop": "^11.1.2",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.0",
    "tsx": "^4.23.13",
    "uuid": "^14.0.0",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.4.0",
    "@types/pako": "^3.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-mock-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "baseline-browser-mapping": "^2.10.20",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "msw": "^2.12.14",
    "prettier": "^3.9.6",
    "redux-mock-store": "^1.5.5",
    "sort-json": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "overrides": {
    "tar": "^7.5.9",
    "minimatch": "^10.2.1",
    "dompurify": "^3.4.13",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
