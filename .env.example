# Domain Caddy serves and requests a certificate for.
# Use `localhost` locally: Caddy then issues a certificate from its internal CA.
APP_DOMAIN=localhost

# Password for the PostgreSQL superuser inside the `db` container.
POSTGRES_PASSWORD=change-me

# Passwords for the roles db/init/00-roles.sql creates on the database's first start:
# app_owner owns the schema and runs migrations; app_user is the API's login.
APP_OWNER_PASSWORD=change-me-owner
APP_USER_PASSWORD=change-me-user

# Connection string the API uses, as app_user. Host `db` is the compose service name.
DATABASE_URL=postgres://app_user:change-me-user@db:5432/invoice_expense

# Connection string the one-shot `migrate` service uses, as app_owner.
MIGRATION_DATABASE_URL=postgres://app_owner:change-me-owner@db:5432/invoice_expense
