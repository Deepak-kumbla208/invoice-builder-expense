# Domain Caddy serves and requests a certificate for.
# Use `localhost` locally: Caddy then issues a certificate from its internal CA.
APP_DOMAIN=localhost

# Password for the PostgreSQL superuser inside the `db` container.
POSTGRES_PASSWORD=change-me

# Connection string the API uses. Host `db` is the compose service name.
DATABASE_URL=postgres://postgres:change-me@db:5432/invoice_expense

# Connection string the one-shot `migrate` service uses. Phase 6 gives this a
# separate, more privileged role; until then it matches DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://postgres:change-me@db:5432/invoice_expense
